 1.3 Nutanix API Client

 File: pkg/controller/provider/container/nutanix/client.go (NEW)

 Implement REST client for Nutanix Prism v3 API:

 Key Dependencies:
 - Option 1: Use github.com/nutanix-cloud-native/prism-go-client SDK
 - Option 2: Implement custom REST client (following oVirt pattern)

 Core Methods:
 type Client struct {
     url           string              // https://prism:9440
     client        *libweb.Client      // HTTP client
     secret        *core.Secret        // Kubernetes secret
     clientTimeout time.Duration
     log           logging.LevelLogger
 }

 func (c *Client) connect() (status int, err error)
     // Authenticate with Basic Auth or API token
     // Test endpoint: POST /api/nutanix/v3/clusters/list

 func (c *Client) list(path string, list interface{}) error
     // POST to /api/nutanix/v3/<resource>/list
     // Note: Nutanix uses POST for list operations with JSON filter

 func (c *Client) clusters() ([]Cluster, error)
 func (c *Client) hosts(clusterUUID string) ([]Host, error)
 func (c *Client) vms(filter map[string]interface{}) ([]VM, error)
 func (c *Client) networks(clusterUUID string) ([]Network, error)
 func (c *Client) storageContainers(clusterUUID string) ([]StorageContainer, error)

 Pattern Reference: pkg/controller/provider/container/ovirt/client.go

 Authentication: Support both username/password and API token via Kubernetes Secret:
 apiVersion: v1
 kind: Secret
 metadata:
   name: nutanix-credentials
 stringData:
   user: "admin"
   password: "password"
   cacert: |
     -----BEGIN CERTIFICATE-----
     ...
   insecureSkipVerify: "false"

