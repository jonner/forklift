FROM registry.access.redhat.com/ubi9/go-toolset:9.8-1788409979 AS builder
USER 0
WORKDIR /app
COPY --chown=1001:0 ./ ./
ENV GOFLAGS="-mod=vendor"
ENV GOCACHE=/go-build/cache
RUN --mount=type=cache,target=${GOCACHE},uid=1001 \
    CGO_ENABLED=0 go build -buildvcs=false -ldflags="-w -s" \
    -o nutanix-nfs-populator github.com/kubev2v/forklift/cmd/nutanix-nfs-populator

# PoC runtime: Fedora ships a working libnfs block driver for qemu-img via the
# qemu-block-nfs package (verified: `qemu-img info nfs://...` opens the Nutanix
# container export). Alpine's qemu-img lists nfs in --help but lacks the runtime
# module. A UBI/downstream image must confirm an equivalent qemu nfs block
# driver (qemu-kvm-block-* on RHEL) before replacing this base.
FROM registry.fedoraproject.org/fedora:40
RUN dnf install -y qemu-img qemu-block-nfs && dnf clean all
COPY --from=builder /app/nutanix-nfs-populator /usr/local/bin/nutanix-nfs-populator
ENTRYPOINT ["/usr/local/bin/nutanix-nfs-populator"]

ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

LABEL \
        name="migration-toolkit-virtualization/mtv-nutanix-nfs-populator-rhel9" \
        license="Apache License 2.0" \
        io.k8s.display-name="Migration Toolkit for Virtualization" \
        io.k8s.description="Migration Toolkit for Virtualization - Nutanix NFS Volume Populator" \
        io.openshift.tags="migration,mtv,forklift" \
        summary="Migration Toolkit for Virtualization - Nutanix NFS Volume Populator" \
        description="Migration Toolkit for Virtualization - Nutanix NFS Volume Populator" \
        org.opencontainers.image.revision="$GIT_COMMIT" \
        org.opencontainers.image.created="$BUILD_DATE" \
        org.opencontainers.image.source="https://github.com/kubev2v/forklift"
